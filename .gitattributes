# Line ending normalization for Maven wrapper scripts
/mvnw text eol=lf
*.cmd text eol=crlf

# Ensure consistent line endings for source files across OSes
*.java text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf

# Treat these as binary — don't let git try to diff/merge them as text
*.jar binary
*.png binary
*.jpg binary
*.jpeg binarys